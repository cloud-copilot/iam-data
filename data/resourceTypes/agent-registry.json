{
  "registry": {
    "key": "registry",
    "arn": "arn:${Partition}:agent-registry:${Region}:${Account}:registry/${RegistryId}",
    "conditionKeys": [
      "aws:ResourceTag/${TagKey}"
    ]
  },
  "registry-record": {
    "key": "registry-record",
    "arn": "arn:${Partition}:agent-registry:${Region}:${Account}:registry/${RegistryId}/record/${RecordId}",
    "conditionKeys": [
      "aws:ResourceTag/${TagKey}"
    ]
  }
}